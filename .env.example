# Server-only secrets — never expose via VITE_* variables.
# Copy to `.env.local` (loaded by `vercel dev`) and fill in real values.

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Service role key (Settings → API). Backend only; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Seed board UUID (see supabase/migrations/0001_media_foundation.sql)
BOARD_ID=00000000-0000-0000-0000-000000000001
